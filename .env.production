# ============================================================
# ChatNote — Production Environment Template
# Copy this to .env and fill in your values
# ============================================================

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://chatnote:changeme@pgbouncer:6432/chatnote
POSTGRES_PASSWORD=changeme

# ── Security ──────────────────────────────────────────────
# MUST CHANGE — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=chatnote-secret-key-change-in-production
# MUST SET — generate with: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# ── AI Provider Keys (only fill in the ones you use) ──────
# OpenAI (used for embeddings: text-embedding-3-small)
OPENAI_API_KEY=
# Moonshot/Kimi (used as global fallback for vision)
MOONSHOT_API_KEY=

# ── Embedding ─────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=768

# ── App ───────────────────────────────────────────────────
APP_NAME=ChatNote
DEBUG=false
UPLOAD_DIR=./uploads
