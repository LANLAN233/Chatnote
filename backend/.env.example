# ============================================================
# ChatNote — Environment Variables
# For Docker deployment: copy .env.production → .env and edit
# For local dev:     copy .env.example    → .env and edit
# ============================================================

# ── Database ──────────────────────────────────────────────
# Local dev:   postgresql+asyncpg://chatnote:changeme@localhost:6432/chatnote
# Docker:      postgresql+asyncpg://chatnote:changeme@pgbouncer:6432/chatnote
DATABASE_URL=postgresql+asyncpg://chatnote:changeme@localhost:6432/chatnote
POSTGRES_PASSWORD=changeme

# ── Security (MUST CHANGE IN PRODUCTION) ─────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=chatnote-secret-key-change-in-production
# Generate: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# ── AI Provider Keys ──────────────────────────────────────
# Each user can configure their own keys via the Settings UI.
# These global keys are fallbacks only.
OPENAI_API_KEY=
MOONSHOT_API_KEY=

# ── Embedding ─────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=768

# ── App ───────────────────────────────────────────────────
APP_NAME=ChatNote
DEBUG=true
UPLOAD_DIR=./uploads
